    "audit:visual": "node scripts/audit-visual.mjs despues"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "^7946.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
